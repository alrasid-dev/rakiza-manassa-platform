# انسخ إلى .env محلياً. لا ترفع القيم الحقيقية إلى GitHub.
DATABASE_URL=
VITE_DATABASE_URL=
JWT_SECRET=
PLATFORM_OWNER_EMAIL=rakizaplatform@gmail.com

# الصيغة التي يقرأها Vite وVercel:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Firebase Authentication (اعتماد الخادم للتحقق من الرمز + إعداد الويب للواجهة):
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# إرسال البريد والتنبيهات (Brevo):
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# إشعارات المتصفح (Web Push):
# المسار الأول (مستحسن): Firebase Cloud Messaging — يكفي إعداد Firebase Web أدناه مع حساب الخدمة.
#   المفتاح العام أدناه يُقرأ تلقائياً من shared/push.ts إن لم يُضبط VITE_FIREBASE_VAPID_KEY.
# المسار الثاني (بديل مستقل): زوج مفاتيح VAPID خاص بالمشروع عبر: node scripts/generate-vapid-keys.mjs
VAPID_SUBJECT=mailto:rakizaplatform@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# البصمة/مفتاح المرور: يُشتق النطاق تلقائياً من نطاق الطلب، وهذان المتغيران للتحكم الصريح فقط:
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
